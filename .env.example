# Copy this file to .env.local and fill in values from
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Teams log in with a code (AIF-001) + PIN. Internally each team is a
# Supabase user with the email <code>@<this domain>. No mail is ever sent.
NEXT_PUBLIC_TEAM_EMAIL_DOMAIN=teams.aifiles.local

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@aifiles.local
SEED_ADMIN_PASSWORD=change-me-admin-123
SEED_JUDGE_PASSWORD=change-me-judge-123

# Public address of the app, printed on credential slips (e.g. https://aifiles.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Login capacity planning (server-only, optional; shown on the admin dashboard
# and used by `npm run verify:prod`). See docs/PRE_PRODUCTION_CHECKLIST.md §16.
EVENT_DEVICES_PER_TEAM=3
# Minutes over which teams log in (5 = everyone at once, the worst case)
EVENT_LOGIN_WINDOW_MINUTES=5
# The sign-in/token-refresh limit you set in Supabase → Authentication → Rate Limits (per 5 minutes)
SUPABASE_AUTH_TOKEN_LIMIT_PER_5MIN=
